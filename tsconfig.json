{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "skipLibCheck": true,
    "strict": false,
    "types": [
      "react"
    ]
  },
  "include": [
    "src/**/*.js"
  ],
  "extends": "expo/tsconfig.base"
}
